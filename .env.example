# SQLite local (recommended — Postgres is a stub internal/storage/postgres.go:7)
DATABASE_URL=sqlite:mathua.db
PORT=8080
# Optional — if unset, a random HS256 secret is generated each run (set for persistence)
JWT_SECRET=
# Optional CORS allowlist — comma-separated; empty = allow all (dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://mathua.example.com
