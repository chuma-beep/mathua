# SQLite local (or postgres:// via pgx, implemented internal/storage/postgres.go:7)
DATABASE_URL=sqlite:mathua.db
# Example: DATABASE_URL=postgres://user:pass@localhost/mathua?sslmode=disable
PORT=8080
# REQUIRED in production — if unset, a random HS256 secret is generated each run and all tokens invalidate on restart
# Generate with: openssl rand -hex 32
JWT_SECRET=
# CORS allowlist — comma-separated; empty = allow all (dev). In production MUST include your frontend origin.
# Wildcard "*" suffix supported, e.g. "https://*.vercel.app" for preview deployments.
# Example: CORS_ALLOWED_ORIGINS=https://mathua.vercel.app,https://*.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://mathua.example.com
# Google OAuth (optional) — enables One-Tap + redirect login. Keep username/password intact.
# Create at https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID (Web)
# Authorized origins: https://mathua.vercel.app,https://mathua-28gijw.fly.dev,http://localhost:3000
# Authorized redirect: https://mathua-28gijw.fly.dev/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://mathua-28gijw.fly.dev/api/auth/google/callback
