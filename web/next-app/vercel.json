{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mathua.fly.dev/api/:path*"
    }
  ]
}
