{
  "\\sfrac": "\\frac{#1}{#2}",
  "\\substitute": "{#1}",
  "\\highlight": "{#1}",
  "\\lowlight": "{#1}",
  "\\secondhighlight": "{#1}",
  "\\thirdhighlight": "{#1}",
  "\\firsthighlight": "{#1}",
  "\\fourthhighlight": "{#1}",
  "\\addright": "{#1}",
  "\\subtractright": "{#1}",
  "\\divideunder": "\\frac{#1}{#2}",
  "\\divideright": "\\overset{#1}{\\div}",
  "\\divideleft": "\\underset{#1}{\\div}",
  "\\cancelto": "\\overset{#1}{\\cancel{#2}}",
  "\\attention": "\\text{⚠}",
  "\\negate": "{#1}",
  "\\multiplyleft": "{#1}",
  "\\multiplyright": "{#1}",
  "\\card": "\\left|#1\\right|",
  "\\pow": "\\mathcal{P}\\left(#1\\right)",
  "\\wonder": "\\stackrel{?}{#1}",
  "\\confirm": "\\stackrel{\\checkmark}{#1}",
  "\\reject": "\\stackrel{\\times}{#1}",
  "\\mbox": "\\text{#1}",
  "\\strut": "\\vphantom{()}",
  "\\imp": "\\implies",
  "\\st": "\\;\\vert\\;",
  "\\abs": "\\left|#1\\right|",
  "\\pinover": "\\overset{#2}{#1}",
  "\\lt": "<",
  "\\gt": ">",
  "\\N": "\\mathbb{N}",
  "\\Z": "\\mathbb{Z}",
  "\\Q": "\\mathbb{Q}",
  "\\R": "\\mathbb{R}",
  "\\C": "\\mathbb{C}",
  "\\-": "\\text{-}",
  "\\apple": "\\text{🍎}",
  "\\dog": "\\text{🐶}",
  "\\cat": "\\text{🐱}"
}
