# Mathua Data Model  --  Entity Relationship

direction: right

Students: students {
  id: TEXT PK
  name: TEXT
  username: TEXT
  password_hash: TEXT
  course_id: TEXT
  xp_total: INTEGER
  xp_today: INTEGER
  xp_date: TEXT
  diagnostic_completed: INTEGER
  daily_xp_goal: INTEGER
  settings: TEXT (JSON)
  created_at: TEXT
}

Progress: concept_progress {
  student_id: TEXT PK (FK)
  concept_id: TEXT PK
  status: TEXT UNSEEN/LEARNING/PRACTICING/MASTERED
  streak: INTEGER
  best_streak: INTEGER
  avg_response_time: REAL
  attempts: INTEGER
  sm2_repetitions: INTEGER
  sm2_interval: INTEGER
  sm2_efactor: REAL
  next_review_due: TEXT
  last_attempted: TEXT
  last_reviewed: TEXT
  mastered_at: TEXT
  weakness_score: REAL
}

Sessions: sessions {
  id: TEXT PK
  student_id: TEXT FK
  started_at: TEXT
}

Attempts: attempts {
  id: INTEGER PK AUTO
  session_id: TEXT FK
  student_id: TEXT FK
  concept_id: TEXT
  answer: TEXT
  expected: TEXT
  correct: INTEGER
  elapsed_seconds: REAL
  timestamp: TEXT
}

Questions: questions {
  id: INTEGER PK AUTO
  concept_id: TEXT
  question: TEXT
  answer: TEXT
  explanation: TEXT
  source: TEXT
  difficulty: REAL
}

# Relationships
Students -- Progress: (1)----<(N)
Students -- Sessions: (1)----<(N)
Students -- Attempts: (1)----<(N)
Sessions -- Attempts: (1)----<(N)

# Styling
nodes: {
  style: {
    font-size: 12
    border-radius: 6
  }
}

edges: {
  style: {
    stroke: "#6b6a64"
  }
}
