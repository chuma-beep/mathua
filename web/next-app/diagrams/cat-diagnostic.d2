# CAT Diagnostic — Binary search frontier detection
style.font: mono

Start: {
  shape: circle
  width: 20
  height: 20
  style: {
    fill: "#1B365D"
    font-color: "#ffffff"
    stroke: "#1B365D"
  }
}

Start -> Midpoint

Midpoint: Test midpoint? {
  shape: diamond
  width: 105
  height: 52
  style: {
    font-color: "#141413"
  }
}

Midpoint -> Forward: "Correct, Fast"

Forward: Forward\n(harder concepts)

Midpoint -> Backward: "Incorrect, Slow"

Backward: Backward\n(foundational)

Forward -> Check
Backward -> Check

Check: 3 correct\nin a row? {
  shape: diamond
  width: 105
  height: 52
  style: {
    font-color: "#141413"
  }
}

Check -> Locked: Yes

Locked: FRONTIER\nLOCKED {
  shape: oval
  style: {
    fill: "#EEF2F7"
    font-color: "#1B365D"
    stroke: "#1B365D"
  }
}

Check -> Midpoint: No

nodes: {
  style: {
    font-size: 10
    border-radius: 4
    stroke: "#6b6a64"
    font-color: "#141413"
  }
}

edges: {
  style: {
    stroke: "#504e49"
    font-size: 9
    font-color: "#504e49"
  }
}
