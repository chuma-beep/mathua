# Mathua System Design  --  Full Architecture

direction: right

UI: UI Layer {
  Web: Web App\nNext.js + React + KaTeX
  
  style: {
    fill: "#FAF9F5"
    stroke: "#E8E6DC"
    font-color: "#141413"
  }
}

API: API Layer {
  Auth: Auth\nSignup / Login / JWT
  Session: Session\nPractice Flow
  Graph: Graph\nDAG Visualization
  Diag: Diagnostic\nAdaptive Testing
  Lboard: Leaderboard\nWeekly Scores
  Reviews: Reviews\nSpaced Repetition
  
  style: {
    fill: "#EEF2F7"
    stroke: "#E8E6DC"
    font-color: "#141413"
  }
}

Engine: Core Engine {
  DAG: DAG Loader\nJSON → Topo-Sorted Graph
  Sched: Scheduler\nSM-2 Priority Queue
  Gen: Generators\n18 Domain Registries
  Master: Mastery\nUNSEEN→LEARNING→PRACTICING→MASTERED
  Score: Scoring\nXP + Speed + Streak
  Weak: Weakness\nPropagation Engine
  DiagEng: Diagnostic\nBinary Search CAT
  
  style: {
    fill: "#FAF9F5"
    stroke: "#E8E6DC"
    font-color: "#141413"
  }
}

Grading: Grading Layer {
  Router: Router\nDispatch by GradingType
  Numeric: Numeric\nInt/Float/Fraction
  Poly: SymPy\nPython Subprocess
  Symbolic: Symbolic\nString Normalize
  Choice: Multiple Choice\nCase-Insensitive
  Comp: Comparison\n>/</=/>=/<=
  Order: Ordering\nPositional Match
  Complex: Complex\nPolar → SymPy
  
  style: {
    fill: "#EEF2F7"
    stroke: "#E8E6DC"
    font-color: "#141413"
  }
}

Storage: Storage Layer {
  Repo: Repository\nInterface
  SQLite: SQLite\nDesktop / Dev
  PG: PostgreSQL\nProduction Web
  
  style: {
    fill: "#FAF9F5"
    stroke: "#E8E6DC"
    font-color: "#141413"
  }
}

# Connections
Web -> Auth
Web -> Session
Web -> Graph
Web -> Diag
Web -> Lboard
Web -> Reviews

# API → Engine
Auth -> DAG
Session -> DAG
Session -> Sched
Session -> Gen
Session -> Master
Session -> Score
Diag -> DiagEng
Reviews -> Sched

# Engine internal
DAG -> Sched
Sched -> Gen
Gen -> Master
Master -> Weak
Master -> Score

# Engine → Grading
Gen -> Router
Router -> Numeric
Router -> Polys
Router -> Symbolic
Router -> Choice
Router -> Comp
Router -> Order
Router -> Complex

# Grading → Storage
Score -> Repo
Master -> Repo
DiagEng -> Repo
Repo -> SQLite
Repo -> PG

# Styling
nodes: {
  style: {
    font-size: 12
    font-color: "#141413"
    border-radius: 4
  }
}

edges: {
  style: {
    stroke: "#6b6a64"
    font-size: 10
    font-color: "#504e49"
  }
}
