  {
    "label": "Worked linear solve",
    "section": "Integrating Factor Method",
    "subgoals": [
      "Read P = 2 for mu = e^{2x}",
      "Multiply through to d(e^{2x} y)/dx = 6e^{3x}",
      "Integrate to y = 2e^x + Ce^{-2x}"
    ]
  },
