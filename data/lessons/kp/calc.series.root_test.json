    "label": "Proof",
    "section": "Proof",
    "subgoals": [
      "Compare |a_n| against r^n with L < r < 1",
      "Squeeze tails by geometric series",
      "Treat L = 1 as inconclusive"
    ]
  },
  {
    "label": "Example",
    "section": "Example",
    "subgoals": [
      "Compute L = 2/3 for sum 2^n/3^n",
      "Conclude convergence since L < 1",
      "Contrast with sum 1/n giving L = 1"
    ]
