    "section": "Solution Method",
    "subgoals": [
      "Separate dy/dx = 2xy to dy/y = 2x dx",
      "Integrate to ln|y| = x^2 + C",
      "Exponentiate to y = Ae^{x^2}"
    ]
  },
  {
    "label": "Initial value version",
    "section": "Solution Method",
    "subgoals": [
      "Separate dy/dx = y^2 with y(0) = 1",
      "Integrate to y = -1/(x + C)",
      "Apply y(0) = 1 to get y = 1/(1-x)"
    ]
  }
